{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core APIs, native save dialogs, writing the file the user picked, and update checks, and opening the project's GitHub pages in the system browser",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/akhan157/astraea"
        },
        {
          "url": "https://github.com/akhan157/astraea/*"
        }
      ]
    }
  ]
}
