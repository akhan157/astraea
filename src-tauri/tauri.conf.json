{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Astraea Workstation",
  "version": "../package.json",
  "identifier": "com.astraea.workstation",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev --port 1420 --strictPort",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob:",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "connect-src": "'self' ipc: http://ipc.localhost https://www.thrustcurve.org https://api.open-meteo.com",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Open-source rocket engineering environment",
    "longDescription": "Astraea unified open-source rocket engineering environment: 6-DOF trajectory, Barrowman stability, Gibbs propulsion, Monte Carlo dispersion.",
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyMDM0MzcyN0IwNDdDRkEKUldUNmZBUjdja01EMHAzV1pDZ0J0T016ZFViM05vM2lUNE1LQ01WRzZMa21PNm00MTErOGp6cTkK",
      "endpoints": [
        "https://github.com/akhan157/astraea/releases/download/update-feed/latest.json",
        "https://github.com/akhan157/astraea/releases/latest/download/latest.json"
      ]
    }
  }
}
